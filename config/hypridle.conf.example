# hypridle-terminal-dim
# Add this listener to your hypridle config (~/.config/hypr/hypridle.conf).
# You can source this file directly or copy the listener block.

# Dim terminal after 5 seconds of idle, restore on activity
listener {
    timeout = 5
    on-timeout = ~/.local/bin/window-idle-dim.sh
    on-resume = ~/.local/bin/window-idle-restore-terminal.sh
}
